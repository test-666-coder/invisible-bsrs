# OpenAI API key for the final BSRS JSON step.
OPENAI_API_KEY=sk-your-key

# OpenAI model used only for structured BSRS JSON generation.
OPENAI_BSRS_MODEL=gpt-4o-mini

# OpenAI model used to repair de-identified ASR transcript typos before scoring.
OPENAI_TRANSCRIPT_MODEL=gpt-4o-mini

# Local Hugging Face models. Swap these based on CPU/GPU capacity.
ASR_MODEL_ID=openai/whisper-base
NER_MODEL_ID=ckiplab/albert-tiny-chinese-ner
EMOTION_MODEL_ID=Dpngtm/wav2vec2-emotion-recognition
TTS_MODEL_ID=wuula/speecht5_tts_common_voice_zh
TTS_VOCODER_ID=microsoft/speecht5_hifigan

# ASR language hint for Whisper.
ASR_LANGUAGE=zh

# auto, cpu, cuda, cuda:0, or an integer device id accepted by transformers.
HF_DEVICE=auto

# Optional shared model cache path.
# HF_HOME=C:\Users\USER\.cache\huggingface

# Recommended on Windows when Developer Mode is off.
HF_HUB_DISABLE_SYMLINKS=1
